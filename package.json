{
  "name": "urz-timetable",
  "version": "2.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deploy": "pnpm lint && pnpm typecheck && pnpm build && pnpm audit && pnpm audit --prod"
  },
  "dependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/modals": "9.6.2",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sharp": "0.35.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.12",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "serwist": "^9.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "^4.28.7"
    }
  }
